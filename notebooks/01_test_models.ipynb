## 3. Spending tracker
Logs the cost of every call to a CSV in our private Drive folder, so the total carries over between sessions and notebooks. Each provider has a budget; the notebook stops before going over it.

import os
import pandas as pd
from datetime import datetime
from google.colab import drive

drive.mount("/content/drive")
FOLDER = "/content/drive/MyDrive/TARA Project/Project Outputs"
os.makedirs(FOLDER, exist_ok=True)
COST_LOG = f"{FOLDER}/cost_log.csv"

# Maximum spend per provider for the whole project
BUDGETS  = {"OpenRouter": 20.00, "Anthropic": 100.00, "Sarvam": 1000.00}
CURRENCY = {"OpenRouter": "US$",  "Anthropic": "US$",   "Sarvam": "₹"}

# Prices per million tokens (input, output), checked 15 Nov 2026.
# OpenRouter reports its own cost per call, so it is not listed here.
PRICES = {
    "claude-haiku-5-5": (0.10, 0.50),    # US$, prompts under 100k tokens
    "claude-opus-5-5":  (4.00, 20.00),   # US$
    "sarvam-105b":      (15.00, 60.00),  # ₹
}

# Load spending from earlier sessions so the counter carries over
cost_log = pd.read_csv(COST_LOG).to_dict("records") if os.path.exists(COST_LOG) else []

def spent(provider):
    return sum(r["cost"] for r in cost_log if r["provider"] == provider)

def check_budget(provider):
    if spent(provider) >= BUDGETS[provider]:
        raise RuntimeError(f"{provider} budget reached ({CURRENCY[provider]}{BUDGETS[provider]}). Stopping.")

def record(provider, model, tokens_in, tokens_out, cost):
    cost_log.append({
        "time": datetime.now().isoformat(timespec="seconds"),
        "provider": provider, "model": model,
        "tokens_in": tokens_in, "tokens_out": tokens_out, "cost": cost,
    })
    pd.DataFrame(cost_log).to_csv(COST_LOG, index=False)  # saved after every call

def show_spend():
    print("\nSpend so far:")
    for p in BUDGETS:
        print(f"  {p:10} {CURRENCY[p]}{spent(p):.4f} of {CURRENCY[p]}{BUDGETS[p]:.2f}")

show_spend()

## 4. Connect to each provider
- **OpenRouter:** gpt-oss-120b, Llama 3.3 70B and the two judges (gpt-4o-mini, Claude Haiku 4.5)
- **Sarvam API:** Sarvam 105B
- **Anthropic API:** Claude Haiku 5.5 and Opus 5.5 (frontier check)

import requests
from openai import OpenAI
import anthropic

openrouter = OpenAI(base_url="https://openrouter.ai/api/v1", api_key=OPENROUTER_API_KEY)
claude = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)

def ask_openrouter(model, prompt, max_tokens=500):
    check_budget("OpenRouter")
    r = openrouter.chat.completions.create(
        model=model,
        messages=[{"role": "user", "content": prompt}],
        max_tokens=max_tokens,
    )
    extra = r.usage.model_extra or {}
    record("OpenRouter", model, r.usage.prompt_tokens, r.usage.completion_tokens, extra.get("cost", 0.0))
    return r.choices[0].message.content

def ask_sarvam(prompt, max_tokens=2048):
    check_budget("Sarvam")
    r = requests.post(
        "https://api.sarvam.ai/v1/chat/completions",
        headers={"api-subscription-key": SARVAM_API_KEY, "Content-Type": "application/json"},
        json={
            "model": "sarvam-105b",
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens,     # Sarvam reasons before answering, so it needs room
            "reasoning_effort": "low",
        },
        timeout=120,
    )
    r.raise_for_status()
    data = r.json()
    usage = data.get("usage", {})
    t_in, t_out = usage.get("prompt_tokens", 0), usage.get("completion_tokens", 0)
    p_in, p_out = PRICES["sarvam-105b"]
    record("Sarvam", "sarvam-105b", t_in, t_out, (t_in * p_in + t_out * p_out) / 1_000_000)
    return data["choices"][0]["message"]["content"]

def ask_claude(model, prompt, max_tokens=2000):
    check_budget("Anthropic")
    r = claude.messages.create(
        model=model,
        max_tokens=max_tokens,   # room for thinking plus the answer
        messages=[{"role": "user", "content": prompt}],
    )
    p_in, p_out = PRICES[model]
    record("Anthropic", model, r.usage.input_tokens, r.usage.output_tokens,
           (r.usage.input_tokens * p_in + r.usage.output_tokens * p_out) / 1_000_000)
    # keep only the text parts of the reply (Opus 5.5 also returns thinking blocks)
    return "".join(block.text for block in r.content if block.type == "text")

## 5. Send one harmless test request to every model
Every model should print OK. An ERROR usually means a wrong key name, no credit on that account, or a changed model name.

TEST_PROMPT = "Say hello in Hindi and Bengali, in one short sentence each."

models = [
    ("Sarvam 105B",         lambda p: ask_sarvam(p)),
    ("gpt-oss-120b",        lambda p: ask_openrouter("openai/gpt-oss-120b", p)),
    ("Llama 3.3 70B",       lambda p: ask_openrouter("meta-llama/llama-3.3-70b-instruct", p)),
    ("gpt-4o-mini (judge)", lambda p: ask_openrouter("openai/gpt-4o-mini", p)),
    ("Haiku 4.5 (judge)",   lambda p: ask_openrouter("anthropic/claude-haiku-4.5", p)),
    ("Haiku 5.5",           lambda p: ask_claude("claude-haiku-5-5", p)),
    ("Opus 5.5",            lambda p: ask_claude("claude-opus-5-5", p)),
]

results = []
for name, ask in models:
    try:
        answer = ask(TEST_PROMPT)
        status = "OK"
    except Exception as e:
        answer = str(e)[:200]
        status = "ERROR"
    results.append({"model": name, "status": status, "answer": answer})
    print(f"{status:6} {name}: {answer[:80]}")

df = pd.DataFrame(results)
show_spend()

